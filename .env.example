# VeilFi Frontend Environment Variables
# Copy this to .env.local and fill in real values

# Alchemy key — same key used in hardhat.config.js
ALCHEMY_KEY=your_alchemy_api_key_here

# RPC endpoint for browser-side read calls (Sepolia)
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# Deployed contract addresses on Sepolia (fill after deploy)
VITE_CREDIT_VERIFIER=0x0000000000000000000000000000000000000001
VITE_SBT_CONTRACT=0x0000000000000000000000000000000000000002
VITE_LOAN_MARKETPLACE=0x0000000000000000000000000000000000000003
